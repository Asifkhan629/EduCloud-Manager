# Copy this file to .env and set a unique secret before using the app.
SECRET_KEY=replace-with-a-long-random-secret
FLASK_DEBUG=1
FLASK_ENV=development
DATABASE_URL=sqlite:///educloud.db
AUTO_CREATE_DB=1
COOKIE_SECURE=0
ATTENDANCE_THRESHOLD=75
# Set 1 to remove officially approved leave from attendance denominator.
EXCLUDE_APPROVED_LEAVE=0
# JSON object of minimum percentage by grade; highest threshold is checked first.
GRADE_BOUNDARIES={"A+":90,"A":80,"B":70,"C":60,"D":50,"F":0}
# For multi-instance production, configure a shared Redis URL instead of process memory.
RATELIMIT_STORAGE_URI=memory://
